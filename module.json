{
  "id": "blizzards-wondrous-spellbook",
  "title": "Blizzard's Wondrous Spellbook",
  "description": "A spellbook creator and slot-fill tool for the Pathfinder Second Edition system.",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Diego Vescovini"
    }
  ],
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/spellbook.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.0.0",
          "verified": "8.4.1"
        }
      }
    ],
    "recommends": [
      {
        "id": "sequencer",
        "type": "module",
        "reason": "Required to play JB2A animations when a spell is cast. The module works without it; animation controls simply do not appear."
      },
      {
        "id": "JB2A_DnD5e",
        "type": "module",
        "reason": "Provides the free JB2A animation library. Optional - animation controls are hidden when absent."
      },
      {
        "id": "jb2a_patreon",
        "type": "module",
        "reason": "Provides the full JB2A animation library. Optional - animation controls are hidden when absent."
      }
    ]
  },
  "socket": false,
  "url": "https://github.com/sargas79/wondrous-spellbook",
  "manifest": "https://github.com/sargas79/wondrous-spellbook/releases/latest/download/module.json",
  "download": "https://github.com/sargas79/wondrous-spellbook/releases/latest/download/module.zip",
  "license": "LICENSE"
}
